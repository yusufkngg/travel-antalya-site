      <div class="listing-row-media">
        <img src="{{ item.data.cover }}" alt="{{ item.data.title }}">
      </div>
      <div class="listing-row-body">
        <div class="listing-row-top">
          <div>
            <span class="badge badge-verified">{{ item.data.category }}</span>
            <h3 class="listing-row-title"><a href="/things-to-do/{{ item.data.title | slugify }}/">{{ item.data.title }}</a></h3>
          </div>
          <a href="/things-to-do/{{ item.data.title | slugify }}/" class="listing-row-arrow">↗</a>
        </div>
        <p class="listing-row-excerpt">{{ item.data.excerpt }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

