---
layout: base.njk
pageTitle: "Restaurants in Antalya — Eat & Drink"
pageDescription: "Seafood on the harbor, rooftop views over Kaleiçi, and the region's own take on Turkish classics."
pageUrl: "/restaurants/"
ogImage: "/images/photos/michelin-hotels.jpg"
permalink: "/restaurants/index.html"
schema:
  "@context": "https://schema.org"
  "@type": "CollectionPage"
  name: "Restaurants in Antalya"
  url: "https://travel-antalya.com/restaurants/"
eleventyExcludeFromCollections: true
---
<section class="listing-hero">
  <div class="container">
    <span class="eyebrow">Eat &amp; Drink</span>
    <h1>Where to Eat in Antalya</h1>
    <p class="lead" style="max-width:620px;">Seafood on the old harbor, rooftop tables over Kaleiçi, and the region's own take on Turkish classics.</p>
  </div>
</section>

<section style="padding-top:0;">
  <div class="container">
    <div class="filter-bar">
      <span class="filter-pill">Cuisine</span>
      <span class="filter-pill">Neighborhood</span>
      <span class="filter-pill">Price</span>
      <span class="filter-pill">Michelin</span>
    </div>
    <p class="results-count">Showing {{ collections.restaurants.length }} restaurants</p>

    {% for r in collections.restaurants %}
    <div class="listing-row">
      <div class="listing-row-media">
        <img src="{{ r.data.cover }}" alt="{{ r.data.title }}">
      </div>
      <div class="listing-row-body">
        <div class="listing-row-top">
          <div>
            {% if r.data.tags %}
              {% for tag in r.data.tags %}
                {% if tag == "sponsored" %}<span class="badge badge-sponsored">Sponsored</span>{% endif %}
                {% if tag == "editors-choice" %}<span class="badge badge-editors">Editor's Choice</span>{% endif %}
              {% endfor %}
            {% endif %}
            <h3 class="listing-row-title"><a href="/restaurants/{{ r.data.title | slugify }}/">{{ r.data.title }}</a></h3>
          </div>
          <a href="/restaurants/{{ r.data.title | slugify }}/" class="listing-row-arrow">↗</a>
        </div>
        <p class="listing-row-excerpt">{{ r.data.excerpt }}</p>
        <div class="listing-row-meta">
          <span>{{ r.data.category }}</span>
          <span>·</span>
          <span>{{ r.data.neighborhood }}</span>
          <span class="price">{{ r.data.price }}</span>
        </div>
      </div>
    </div>
    {% endfor %}

  </div>
</section>
