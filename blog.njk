---
layout: base.njk
pageTitle: "Blog — Travel Antalya"
pageDescription: "Guides, itineraries and local tips for Antalya, Turkey."
pageUrl: "/blog/"
ogImage: "/images/photos/antalya-beach-drone.jpg"
permalink: "/blog/index.html"
eleventyExcludeFromCollections: true
---
{% set posts = collections.blog %}
<section style="padding-top:56px; padding-bottom:40px;">
  <div class="container">
    <span class="eyebrow">The Blog</span>
    <h1 style="font-size:clamp(2.2rem,4vw,3.2rem);">Guides, itineraries &amp; local tips</h1>
    <p class="lead" style="max-width:600px; font-size:1.05rem;">Everything we know about getting around, eating well, and seeing Antalya properly — {{ posts.length }} guides and counting.</p>
  </div>
</section>

<section style="padding-top:0;">
  <div class="container" style="max-width:820px;">
    {% for post in posts %}
    <a href="/blog/{{ post.data.slug }}/" class="post-row" style="text-decoration:none;">
      <div class="card-media"><span class="card-tag">{{ post.data.category }}</span>
        <img src="{{ post.data.cover }}" alt="{{ post.data.title }}">
      </div>
      <div>
        <span class="post-date">{{ post.data.category }} · {{ post.data.date_display }}</span>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.excerpt }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
